generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALARIE
  MANAGER
  SUPER_ADMIN
}

enum ShiftStatus {
  BROUILLON
  PUBLIE
  EN_ATTENTE_DEROGATION
  ANNULE
}

enum SwapStatus {
  EN_ATTENTE_EQUIPIER
  EN_ATTENTE_MANAGER
  VALIDE
  REFUSE
}

enum QualificationStatus {
  CONFORME
  HEURES_MODIFIEES
  RETARD
  ABSENT_INJUSTIFIE
  MALADIE
  VACANCES
}

model User {
  id                  String       @id @default(cuid())
  matricule           String       @unique
  email               String       @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                Role         @default(SALARIE)
  contractWeeklyHours Float        @default(35.0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  shifts              Shift[]      @relation("UserShifts")
  timeEntries         TimeEntry[]  @relation("UserTimeEntries")
  arbitratedEntries   TimeEntry[]  @relation("ManagerArbitrations")
  swapRequestsSent    ShiftSwap[]  @relation("SwapRequester")
  swapRequestsRecv    ShiftSwap[]  @relation("SwapTarget")
  auditLogs           AuditLog[]

  @@index([role])
}

model Shift {
  id                    String       @id @default(cuid())
  userId                String
  startTime             DateTime
  endTime               DateTime
  status                ShiftStatus  @default(BROUILLON)

  acknowledgedAt        DateTime?
  isLateModification    Boolean      @default(false)
  derogationRequestedAt DateTime?
  derogationAcceptedAt  DateTime?
  derogationComment     String?

  planningVersion       Int          @default(1)

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user                  User         @relation("UserShifts", fields: [userId], references: [id], onDelete: Cascade)
  timeEntries           TimeEntry[]
  shiftSwaps            ShiftSwap[]

  @@index([userId, startTime])
  @@index([startTime, endTime])
  @@index([status])
}

model TimeEntry {
  id                    String              @id @default(cuid())
  shiftId               String?
  userId                String

  clockInTime           DateTime
  rawClockOutTime       DateTime?
  roundedClockOutTime   DateTime?

  correctedClockInTime  DateTime?
  correctedClockOutTime DateTime?
  qualification         QualificationStatus @default(CONFORME)
  discrepancyReason     String?
  arbitrationReason     String?
  managerId             String?
  arbitratedAt          DateTime?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  shift                 Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user                  User                @relation("UserTimeEntries", fields: [userId], references: [id], onDelete: Cascade)
  manager               User?               @relation("ManagerArbitrations", fields: [managerId], references: [id])

  @@index([userId, clockInTime])
  @@index([shiftId])
  @@index([qualification])
}

model ShiftSwap {
  id                String     @id @default(cuid())
  shiftId           String
  requesterId       String
  targetUserId      String
  status            SwapStatus @default(EN_ATTENTE_EQUIPIER)

  reason            String?
  peerApprovedAt    DateTime?
  managerApprovedAt DateTime?
  rejectedReason    String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  shift             Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requester         User       @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUser        User       @relation("SwapTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  tableName String
  recordId  String
  userId    String?
  payloadOld Json?
  payloadNew Json?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@index([timestamp])
  @@index([userId])
}

model MasterTemplate {
  id         String   @id @default(cuid())
  name       String
  weekNumber Int      @default(1)
  dayOfWeek  Int
  startTime  String
  endTime    String
  roleTarget Role     @default(SALARIE)
  isActive   Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([weekNumber, dayOfWeek, isActive])
}

model CompanySettings {
  id                 String @id @default("default")
  noticeDelayDays    Int    @default(8)
  roundingMinutes    Int    @default(15)
  maxWeeklyHours     Float  @default(48.0)
  minDailyRestHours  Float  @default(11.0)
}
