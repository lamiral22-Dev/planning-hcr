generator client {
  provider = "prisma-client-js"
}

model RestaurantSlot {
  id         String   @id @default(cuid())
  name       String
  startTime  String
  endTime    String
  sortOrder  Int      @default(0)
  closedDays Int[]    @default([])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shifts   Shift[]
  closures RestaurantClosure[]

  @@index([isActive, sortOrder])
}

model RestaurantClosure {
  id        String   @id @default(cuid())
  slotId    String
  date      DateTime @db.Date
  isClosed  Boolean  @default(true)
  createdAt DateTime @default(now())

  slot RestaurantSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, date])
  @@index([date])
}

enum ReplacementStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  ANNULEE
}

model ShiftReplacementRequest {
  id             String            @id @default(cuid())
  shiftId        String
  proposedUserId String
  requestedById  String
  status         ReplacementStatus @default(EN_ATTENTE)
  respondedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  shift        Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  proposedUser User  @relation("ReplacementProposedUser", fields: [proposedUserId], references: [id], onDelete: Cascade)
  requestedBy  User  @relation("ReplacementRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([shiftId, status])
  @@index([proposedUserId, status])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALARIE
  MANAGER
  SUPER_ADMIN
}

enum ShiftStatus {
  BROUILLON
  PUBLIE
  EN_ATTENTE_DEROGATION
  ANNULE
}

enum SwapStatus {
  EN_ATTENTE_EQUIPIER
  EN_ATTENTE_MANAGER
  VALIDE
  REFUSE
}

enum QualificationStatus {
  CONFORME
  HEURES_MODIFIEES
  RETARD
  ABSENT_INJUSTIFIE
  MALADIE
  VACANCES
}

model User {
  id                  String   @id @default(cuid())
  matricule           String   @unique
  email               String   @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                Role     @default(SALARIE)
  contractWeeklyHours Float    @default(35.0)
  cpAdjustment        Float    @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shifts                Shift[]                   @relation("UserShifts")
  timeEntries           TimeEntry[]               @relation("UserTimeEntries")
  arbitratedEntries     TimeEntry[]               @relation("ManagerArbitrations")
  swapRequestsSent      ShiftSwap[]               @relation("SwapRequester")
  swapRequestsRecv      ShiftSwap[]               @relation("SwapTarget")
  auditLogs             AuditLog[]
  replacementRequests   ShiftReplacementRequest[] @relation("ReplacementProposedUser")
  initiatedReplacements ShiftReplacementRequest[] @relation("ReplacementRequestedBy")
  leaveRequests         LeaveRequest[]

  @@index([role])
  @@index([isActive])
}

model LeaveRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  type          String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  reason        String?
  status        String   @default("EN_ATTENTE")
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pendingShifts Shift[]

  @@index([userId, status, startDate, endDate])
}

model Shift {
  id        String      @id @default(cuid())
  userId    String
  slotId    String?
  startTime DateTime
  endTime   DateTime
  status    ShiftStatus @default(BROUILLON)

  acknowledgedAt        DateTime?
  isLateModification    Boolean   @default(false)
  derogationRequestedAt DateTime?
  derogationAcceptedAt  DateTime?
  derogationComment     String?

  planningVersion Int @default(1)
  leaveRequestId String?
  leaveAction    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                      @relation("UserShifts", fields: [userId], references: [id], onDelete: Cascade)
  slot                RestaurantSlot?           @relation(fields: [slotId], references: [id], onDelete: SetNull)
  timeEntries         TimeEntry[]
  shiftSwaps          ShiftSwap[]
  replacementRequests ShiftReplacementRequest[]
  leaveRequest        LeaveRequest?             @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  @@index([userId, startTime])
  @@index([slotId, startTime])
  @@index([startTime, endTime])
  @@index([status])
}

model TimeEntry {
  id      String  @id @default(cuid())
  shiftId String?
  userId  String

  clockInTime         DateTime
  rawClockOutTime     DateTime?
  roundedClockOutTime DateTime?

  correctedClockInTime  DateTime?
  correctedClockOutTime DateTime?
  qualification         QualificationStatus @default(CONFORME)
  discrepancyReason     String?
  arbitrationReason     String?
  managerId             String?
  arbitratedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shift   Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user    User   @relation("UserTimeEntries", fields: [userId], references: [id], onDelete: Cascade)
  manager User?  @relation("ManagerArbitrations", fields: [managerId], references: [id])

  @@index([userId, clockInTime])
  @@index([shiftId])
  @@index([qualification])
}

model ShiftSwap {
  id           String     @id @default(cuid())
  shiftId      String
  requesterId  String
  targetUserId String
  status       SwapStatus @default(EN_ATTENTE_EQUIPIER)

  reason            String?
  peerApprovedAt    DateTime?
  managerApprovedAt DateTime?
  rejectedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shift      Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requester  User  @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUser User  @relation("SwapTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  tableName  String
  recordId   String
  userId     String?
  payloadOld Json?
  payloadNew Json?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@index([timestamp])
  @@index([userId])
}

model MasterTemplate {
  id         String  @id @default(cuid())
  name       String
  weekNumber Int     @default(1)
  dayOfWeek  Int
  startTime  String
  endTime    String
  roleTarget Role    @default(SALARIE)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekNumber, dayOfWeek, isActive])
}

model CompanySettings {
  id                String @id @default("default")
  noticeDelayDays   Int    @default(8)
  roundingMinutes   Int    @default(15)
  maxWeeklyHours    Float  @default(48.0)
  minDailyRestHours Float  @default(11.0)
}
